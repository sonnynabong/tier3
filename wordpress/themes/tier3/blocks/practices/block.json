    "logos": {
      "type": "array",
      "default": [
        { "id": 0, "alt": "Allure Aesthetics", "file": "allure.webp" },
        { "id": 0, "alt": "Refine Medical Spa", "file": "refine.webp" },
        { "id": 0, "alt": "Destin Botox", "file": "destin.webp" },
        { "id": 0, "alt": "Metro Medspa", "file": "metro.webp" },
        { "id": 0, "alt": "Facial Aesthetics Team", "file": "facial-aesthetics.webp" },
        { "id": 0, "alt": "Lasting Impressions Medical Aesthetics", "file": "lasting-impressions.webp" },
        { "id": 0, "alt": "Essential Aesthetics", "file": "essential.webp" },
        { "id": 0, "alt": "Smile Shop Aesthetics", "file": "smile-shop.webp" },
        { "id": 0, "alt": "Trouvé Medspa", "file": "trouve.webp" }
      ]
