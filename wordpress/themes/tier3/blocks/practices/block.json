  "apiVersion": 3,
  "name": "tier3/practices",
  "title": "Practices",
  "category": "tier3",
  "icon": "groups",
  "description": "Client practice logo grid from the reference homepage.",
  "textdomain": "tier3",
  "editorScript": "tier3-editor",
