    "primaryLabel": { "type": "string", "default": "See if my practice qualifies" },
    "primaryUrl": { "type": "string", "default": "https://link.growtoxsystem.com/widget/form/Ck6UhzscRDYhLSr4dPKl" },
    "secondaryLabel": { "type": "string", "default": "See the results" },
    "secondaryUrl": { "type": "string", "default": "https://tier3media.com/results/" },
    "bottleId": { "type": "number", "default": 0 },
    "captionBrand": { "type": "string", "default": "Growtox<sup>™</sup>" },
    "captionSystem": { "type": "string", "default": "The Schedule-Filler System" },
    "footLeftLabel": { "type": "string", "default": "A simple prescription for profits" },
    "footLeftUrl": { "type": "string", "default": "https://tier3media.com/growtox/" },
    "footRightLabel": { "type": "string", "default": "Explore the results" },
    "footRightUrl": { "type": "string", "default": "#results" }
  }
}
