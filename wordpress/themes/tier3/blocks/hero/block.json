{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "tier3/hero",
  "title": "Hero",
  "category": "tier3",
  "icon": "cover-image",
  "description": "Bottle-led Growtox hero from the reference homepage.",
  "textdomain": "tier3",
  "editorScript": "tier3-editor",
  "render": "file:./render.php",
  "supports": {
    "html": false,
    "anchor": false,
    "multiple": true
  },
  "attributes": {
    "titleLine1": { "type": "string", "default": "Inject your" },
    "titleLine2": { "type": "string", "default": "practice with" },
    "titleLine3": { "type": "string", "default": "more patients!" },
