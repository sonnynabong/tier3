{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "1600px",
      "wideSize": "1600px"
    },
    "spacing": {
      "padding": false,
      "margin": false,
      "blockGap": false
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "fontFamily": "Montserrat, sans-serif",
          "slug": "montserrat",
          "name": "Montserrat",
          "fontFace": [
            {
              "fontFamily": "Montserrat",
              "fontStyle": "normal",
              "fontWeight": "400 800",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/montserrat-latin.woff2"]
            }
          ]
        }
      ]
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "coral", "color": "#ff5151", "name": "Coral" },
        { "slug": "coral-light", "color": "#ff5c5c", "name": "Coral light" },
        { "slug": "violet", "color": "#533cea", "name": "Violet" },
        { "slug": "violet-dark", "color": "#402ac5", "name": "Violet dark" },
        { "slug": "ink", "color": "#232326", "name": "Ink" },
        { "slug": "muted", "color": "#62626b", "name": "Muted" },
        { "slug": "paper", "color": "#ffffff", "name": "Paper" },
        { "slug": "wash", "color": "#f5f6fa", "name": "Wash" },
        { "slug": "line", "color": "#dfe0e6", "name": "Line" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--montserrat)",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "0",
      "padding": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      }
    },
    "elements": {
      "link": {
        "color": { "text": "inherit" },
        "typography": { "textDecoration": "none" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
