---
import '../fonts/montserrat.css';
import '../styles/global.css';
import montserratWoff2 from '../fonts/montserrat-latin.woff2?url';
import favicon from '../assets/logo-coral.svg?url';
import IconLibrary from '../components/IconLibrary.astro';
import SkipLink from '../components/SkipLink.astro';
import {
  email,
  facebookUrl,
  instagramUrl,
  twitterUrl,
} from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ?? 'Tier3 Media — A simple prescription for growth';
const description =
  Astro.props.description ??
  'Discover Tier3 Media’s Growtox Schedule-Filler System for aesthetic practices. Explore client stories and see if your practice qualifies.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/og-growtox.webp', Astro.site);
const socialImageAlt =
  'Growtox Aesthetics Schedule-Filler bottle, Tier3 Media’s marketing system artwork';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  name: 'Tier3 Media',
  url: Astro.site?.href,
  email,
  telephone: '+1-732-808-4113',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '197 State Route 18 South, Ste 3000-4299',
    addressLocality: 'East Brunswick',
    addressRegion: 'NJ',
    postalCode: '08816',
    addressCountry: 'US',
  },
  sameAs: [facebookUrl, instagramUrl, twitterUrl],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ff5151" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="preload" href={montserratWoff2} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <IconLibrary />
    <SkipLink />
    <slot />
  </body>
</html>
